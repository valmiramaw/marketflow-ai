# Verschlüsselung (generiert mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=""

# Google OAuth (Search Console + GA4 + Ads)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
NEXT_PUBLIC_APP_URL=""

# Admin
ADMIN_SECRET=""
CRON_SECRET=""
