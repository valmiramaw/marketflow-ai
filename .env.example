# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis (Upstash)
REDIS_URL=""

# KI-Provider (optional - kann auch über Settings-Seite konfiguriert werden)
ANTHROPIC_API_KEY=""
