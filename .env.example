# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Redis (Upstash)
REDIS_URL=""

# KI-Provider (optional - kann auch über Settings-Seite konfiguriert werden)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Verschlüsselung (generiert mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=""

# Admin
ADMIN_SECRET=""
CRON_SECRET=""
